# Región y recursos de AWS
AWS_REGION=us-east-1
S3_BUCKET_NAME=mi-bucket-usuarios-lab6
DYNAMODB_TABLE=lab6_usuarios

# Credenciales explícitas de AWS (OPCIONALES)
# Déjalas comentadas o vacías si la aplicación corre en EC2 con un IAM Role asignado.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Credenciales del administrador del panel web
ADMIN_USER=admin
ADMIN_PASSWORD=CambiaEstaPasswordSegura123!

# Clave secreta para firmar cookies de sesión (genera una cadena larga y aleatoria)
SECRET_KEY=reemplaza-con-una-clave-aleatoria-segura-de-al-menos-32-caracteres
